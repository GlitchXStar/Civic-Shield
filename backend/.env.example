# ═══════════════════════════════════════════════════
# CIVIC SHIELD — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────
# MongoDB Atlas or local connection string:
MONGODB_URI="mongodb+srv://hackinggauravtiple_db_user:<db_password>@cluster0.m3yyxro.mongodb.net/?appName=Cluster0"
# Or local fallback: mongodb://localhost:27017/civic_shield

# ─── JWT ──────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── File Uploads ─────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
